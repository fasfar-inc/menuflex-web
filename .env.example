# MenuFlex business details. Copy to .env.local (or set in your host) and fill in
# real values. Anything left empty is not shown on the site.

# Public address of the site, without a trailing slash, e.g. https://menuflex.com.tr
NEXT_PUBLIC_SITE_URL=

# WhatsApp number in international format, digits only, e.g. 905xxxxxxxxx
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Phone number as it should be shown and dialled, e.g. +90 5xx xxx xx xx
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_EMAIL=

# Where the hero's demo QR code leads. Defaults to <SITE_URL>/demo/liman/
NEXT_PUBLIC_DEMO_MENU_URL=

# The single subscription, as displayed (e.g. ₺1.500) and its period: month or year
NEXT_PUBLIC_SUBSCRIPTION_PRICE=
NEXT_PUBLIC_SUBSCRIPTION_PERIOD=month

# Supabase, for the admin dashboard at /admin and restaurants published from it.
# Project settings → API. Both values are public by design (the anon key only
# grants what row level security allows). Never put the service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
